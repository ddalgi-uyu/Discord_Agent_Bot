# Discord (shared across all apps)
DISCORD_MODE=webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-token
# DISCORD_BOT_TOKEN=your-bot-token
# DISCORD_CHANNEL_ID=123456789

# AI providers (for news-digest)
ANTHROPIC_API_KEY=sk-ant-your-key
OPENAI_API_KEY=sk-your-key

# News digest specific
NEWS_DIGEST_AI_PROVIDER=anthropic
NEWS_DIGEST_AI_MODEL=claude-3-5-sonnet-latest
