<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme is overridden by Compose at runtime; keep the launcher
         background and status-bar color in sync with the Compose theme. -->
    <style name="Theme.ParkingReminder" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:navigationBarColor">@color/window_background</item>
    </style>
</resources>
